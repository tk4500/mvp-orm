<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>NexusLog — Enterprise Logistics & Delivery System</title>
  <!-- Google Fonts: Geist & Geist Mono -->
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Geist', 'sans-serif'],
            mono: ['Geist Mono', 'monospace'],
          },
          colors: {
            vdark: '#030303',
            surface: '#0a0a0c',
            subtle: '#121216',
          },
          transitionTimingFunction: {
            'spring': 'cubic-bezier(0.32, 0.72, 0, 1)',
          }
        }
      }
    }
  </script>
  <style>
    body {
      font-feature-settings: "liga" on, "tnum" on;
      background-color: #030303;
      color: #ededed;
      touch-action: manipulation;
    }
    .double-bezel-outer {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 1.5rem;
      padding: 6px;
    }
    .double-bezel-inner {
      background: #08080a;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: calc(1.5rem - 4px);
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1);
    }
    /* Custom scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #030303; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 3px; }

    /* Responsive Table to Cards */
    @media (max-width: 639px) {
      .responsive-table, .responsive-table thead, .responsive-table tbody, .responsive-table th, .responsive-table td, .responsive-table tr { display: block; }
      .responsive-table thead tr { position: absolute; top: -9999px; left: -9999px; }
      .responsive-table tr { margin-bottom: 1rem; border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 0.75rem; background: rgba(255, 255, 255, 0.01); padding: 0.25rem 0; }
      .responsive-table td { border: none; border-bottom: 1px solid rgba(255, 255, 255, 0.02); position: relative; padding: 0.75rem !important; padding-left: 45% !important; text-align: right !important; min-height: 44px; display: flex; justify-content: flex-end; align-items: center; }
      .responsive-table td:last-child { border-bottom: 0; }
      .responsive-table td::before { content: attr(data-label); position: absolute; left: 0.75rem; width: 40%; white-space: nowrap; text-align: left; font-size: 0.65rem; text-transform: uppercase; color: #737373; font-family: 'Geist Mono', monospace; font-weight: 500; }
      .responsive-table td.hidden { display: flex !important; } /* Unhide previously hidden columns for card view */
    }
  </style>
</head>
<body class="min-h-[100dvh] flex flex-col selection:bg-blue-500 selection:text-white">

  <!-- Floating Island Glass Navbar -->
  <header class="sticky top-4 z-50 w-[94%] max-w-7xl mx-auto">
    <nav class="rounded-full bg-white/[0.04] backdrop-blur-2xl border border-white/10 px-6 py-3 flex items-center justify-between shadow-[0_8px_32px_rgba(0,0,0,0.5)]">
      <div class="flex items-center gap-6">
        <a href="#" class="flex items-center gap-2.5 text-white font-semibold text-base tracking-tight focus-visible:ring-2 focus-visible:ring-blue-500 rounded-lg">
          <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center font-mono text-xs font-bold text-white shadow-inner">N</div>
          <span>NexusLog <span class="text-xs text-neutral-400 font-normal">v2.4</span></span>
        </a>
        <div class="hidden md:flex items-center gap-1 bg-white/[0.02] border border-white/5 p-1 rounded-full text-xs font-medium">
          <button onclick="switchTab('admin')" id="nav-btn-admin" class="px-4 py-1.5 rounded-full transition-all duration-300 text-white bg-white/10 shadow-sm">Admin Dashboard</button>
          <button onclick="switchTab('scanner')" id="nav-btn-scanner" class="px-4 py-1.5 rounded-full transition-all duration-300 text-neutral-400 hover:text-white">Warehouse Scanner (App)</button>
          <button onclick="switchTab('delivery')" id="nav-btn-delivery" class="px-4 py-1.5 rounded-full transition-all duration-300 text-neutral-400 hover:text-white">Delivery App</button>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-2 text-xs text-neutral-400 font-mono bg-white/[0.02] border border-white/5 px-3 py-1.5 rounded-full">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
          <span>Sync Active</span>
        </div>
        <button onclick="resetDemoData()" class="text-xs text-neutral-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 px-3 py-1.5 rounded-full transition-colors" title="Reset Demo Data">Reset DB</button>
      </div>
    </nav>
  </header>

  <!-- Mobile Bottom Nav (Thumbs-First) -->
  <div class="md:hidden fixed bottom-0 left-0 right-0 z-50 flex items-center justify-around px-2 py-2 bg-[#0a0a0c]/95 backdrop-blur-xl border-t border-white/10 pb-[max(0.5rem,env(safe-area-inset-bottom))]">
    <button onclick="switchTab('admin')" id="mob-btn-admin" class="flex flex-col items-center gap-1 p-2 w-full text-white transition-colors">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
      <span class="text-[10px] font-medium">Dashboard</span>
    </button>
    <button onclick="switchTab('scanner')" id="mob-btn-scanner" class="flex flex-col items-center gap-1 p-2 w-full text-neutral-500 hover:text-neutral-300 transition-colors">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm14 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
      <span class="text-[10px] font-medium">Scanner</span>
    </button>
    <button onclick="switchTab('delivery')" id="mob-btn-delivery" class="flex flex-col items-center gap-1 p-2 w-full text-neutral-500 hover:text-neutral-300 transition-colors">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
      <span class="text-[10px] font-medium">Delivery</span>
    </button>
  </div>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 pb-24 md:p-8 md:pb-8">

    <!-- ==================== TAB 1: ADMIN DASHBOARD ==================== -->
    <div id="tab-admin" class="space-y-8">
      
      <!-- Top Header & Actions -->
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl md:text-3xl font-semibold tracking-tight text-white">Admin Logistics Control</h1>
          <p class="text-sm text-neutral-400 mt-1">Real-time supply chain tracking, depot inventories, and administrative exceptions.</p>
        </div>
        <div class="flex items-center gap-3">
          <button onclick="openModal('create-package-modal')" class="inline-flex items-center gap-2 rounded-full bg-white text-neutral-900 px-5 py-2.5 text-xs font-semibold hover:bg-neutral-200 transition-colors shadow-lg">
            <span>+ Create Package (Depot 01)</span>
          </button>
          <button onclick="openModal('manual-stock-modal')" class="inline-flex items-center gap-2 rounded-full bg-white/[0.05] border border-white/10 text-white px-5 py-2.5 text-xs font-medium hover:bg-white/[0.1] transition-colors">
            <span>Adjust Depot 05 Stock</span>
          </button>
        </div>
      </div>

      <!-- Onboarding Welcome Banner -->
      <div id="onboarding-banner" class="hidden mb-8 p-5 md:p-6 rounded-2xl bg-gradient-to-br from-blue-900/30 to-indigo-900/10 border border-blue-500/20 relative overflow-hidden shadow-lg">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-400/10 via-transparent to-transparent pointer-events-none"></div>
        <button onclick="dismissOnboarding()" class="absolute top-4 right-4 text-blue-400/60 hover:text-white bg-white/5 hover:bg-white/10 w-8 h-8 rounded-full flex items-center justify-center transition-colors" aria-label="Dismiss quick start">&times;</button>
        <div class="relative z-10">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center text-blue-400 shadow-inner">👋</div>
            <h2 class="text-lg font-semibold text-white tracking-tight">Quick Start: Core Loop Simulation</h2>
          </div>
          <p class="text-sm text-blue-200/70 mb-5 max-w-2xl leading-relaxed">This environment demonstrates a real-time logistics state-engine. To see the data flow across the system, follow this 3-step lifecycle:</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-[#0a0a0c]/80 backdrop-blur-sm border border-white/5 p-4 rounded-xl flex items-start gap-3 shadow-inner">
              <div class="w-6 h-6 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center text-xs font-bold shrink-0 border border-blue-500/20">1</div>
              <div>
                <strong class="text-xs text-white block mb-1">Create a Package</strong>
                <span class="text-[11px] text-neutral-400 leading-relaxed block">Click 'Create Package' above to deduct stock from Depot 01 and generate a QR tracking code.</span>
              </div>
            </div>
            <div class="bg-[#0a0a0c]/80 backdrop-blur-sm border border-white/5 p-4 rounded-xl flex items-start gap-3 shadow-inner">
              <div class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center text-xs font-bold shrink-0 border border-amber-500/20">2</div>
              <div>
                <strong class="text-xs text-white block mb-1">Scan in Transit</strong>
                <span class="text-[11px] text-neutral-400 leading-relaxed block">Switch to the <em>Warehouse App</em>, select Depot 02, and click a package to simulate a scan.</span>
              </div>
            </div>
            <div class="bg-[#0a0a0c]/80 backdrop-blur-sm border border-white/5 p-4 rounded-xl flex items-start gap-3 shadow-inner">
              <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs font-bold shrink-0 border border-emerald-500/20">3</div>
              <div>
                <strong class="text-xs text-white block mb-1">Disassemble</strong>
                <span class="text-[11px] text-neutral-400 leading-relaxed block">Select Depot 05 in the scanner, scan the package, and watch the stock arrive at the destination.</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- KPI Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="double-bezel-outer">
          <div class="double-bezel-inner p-6">
            <span class="text-xs font-mono uppercase tracking-wider text-neutral-500">Packages in Transit</span>
            <div class="text-3xl font-semibold text-white mt-2 tabular-nums" id="kpi-transit">0</div>
            <p class="text-xs text-blue-400 mt-1">Active logistics batches</p>
          </div>
        </div>
        <div class="double-bezel-outer">
          <div class="double-bezel-inner p-6">
            <span class="text-xs font-mono uppercase tracking-wider text-neutral-500">Delivered Today</span>
            <div class="text-3xl font-semibold text-white mt-2 tabular-nums" id="kpi-delivered">0</div>
            <p class="text-xs text-emerald-400 mt-1">Final customer handovers</p>
          </div>
        </div>
        <div class="double-bezel-outer">
          <div class="double-bezel-inner p-6">
            <span class="text-xs font-mono uppercase tracking-wider text-neutral-500">Delay Alerts</span>
            <div class="text-3xl font-semibold text-white mt-2 tabular-nums text-amber-400" id="kpi-alerts">0</div>
            <p class="text-xs text-neutral-400 mt-1">Stalled in transit > 48h</p>
          </div>
        </div>
        <div class="double-bezel-outer">
          <div class="double-bezel-inner p-6">
            <span class="text-xs font-mono uppercase tracking-wider text-neutral-500">Total Audit Logs</span>
            <div class="text-3xl font-semibold text-white mt-2 tabular-nums" id="kpi-audits">0</div>
            <p class="text-xs text-purple-400 mt-1">Immutable event trails</p>
          </div>
        </div>
      </div>

      <!-- Inventory Balances (Depot 01 & Depot 05) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Depot 01 (Origin) -->
        <div class="double-bezel-outer">
          <div class="double-bezel-inner p-6">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/5">
              <h2 class="text-base font-semibold text-white">Depósito 01 (Origin / Consolidation)</h2>
              <span class="text-xs font-mono bg-blue-500/10 text-blue-400 border border-blue-500/20 px-2.5 py-1 rounded-full">Source</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm responsive-table">
                <thead>
                  <tr class="text-neutral-500 text-xs font-mono border-b border-white/5">
                    <th class="pb-3 font-medium">SKU / Product</th>
                    <th class="pb-3 font-medium">Category</th>
                    <th class="pb-3 font-medium text-right">Available Qty</th>
                  </tr>
                </thead>
                <tbody id="inventory-depot-1" class="divide-y divide-white/5 text-neutral-300">
                  <!-- Dynamic -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Depot 05 (Final Destination) -->
        <div class="double-bezel-outer">
          <div class="double-bezel-inner p-6">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/5">
              <h2 class="text-base font-semibold text-white">Depósito 05 (Disassembly / Point of Sale)</h2>
              <span class="text-xs font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2.5 py-1 rounded-full">Destination</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm responsive-table">
                <thead>
                  <tr class="text-neutral-500 text-xs font-mono border-b border-white/5">
                    <th class="pb-3 font-medium">SKU / Product</th>
                    <th class="pb-3 font-medium">Category</th>
                    <th class="pb-3 font-medium text-right">Unit Stock</th>
                  </tr>
                </thead>
                <tbody id="inventory-depot-5" class="divide-y divide-white/5 text-neutral-300">
                  <!-- Dynamic -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Package Tracking Table (Gestão de Pacotes) -->
      <div class="double-bezel-outer">
        <div class="double-bezel-inner p-6">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-white/5">
            <div>
              <h2 class="text-lg font-semibold text-white">Package Tracking & Management</h2>
              <p class="text-xs text-neutral-400">All active and processed shipping lots across the depot network.</p>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
              <input type="text" id="package-search" placeholder="Search QR / ID…" oninput="renderPackagesTable()" class="bg-white/[0.03] border border-white/10 rounded-lg px-3 py-1.5 text-xs text-white placeholder-neutral-500 w-full sm:w-64 focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm responsive-table">
              <thead>
                <tr class="text-neutral-500 text-xs font-mono border-b border-white/5">
                  <th class="pb-3 font-medium">QR Code</th>
                  <th class="pb-3 font-medium">Status</th>
                  <th class="pb-3 font-medium">Current Depot</th>
                  <th class="pb-3 font-medium hidden md:table-cell">Items Summary</th>
                  <th class="pb-3 font-medium hidden md:table-cell">Last Update</th>
                  <th class="pb-3 font-medium text-right">Actions (Admin Override)</th>
                </tr>
              </thead>
              <tbody id="packages-table-body" class="divide-y divide-white/5 text-neutral-300">
                <!-- Dynamic -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Audit Logs & Exceptions -->
      <div class="double-bezel-outer">
        <div class="double-bezel-inner p-6">
          <h2 class="text-base font-semibold text-white mb-4">Immutable Movement Audit Log</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs font-mono responsive-table">
              <thead>
                <tr class="text-neutral-500 border-b border-white/5">
                  <th class="pb-2 hidden sm:table-cell">Timestamp</th>
                  <th class="pb-2">Package ID</th>
                  <th class="pb-2">Depot</th>
                  <th class="pb-2 hidden md:table-cell">User</th>
                  <th class="pb-2">Action</th>
                </tr>
              </thead>
              <tbody id="audit-logs-body" class="divide-y divide-white/5 text-neutral-400">
                <!-- Dynamic -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>

    <!-- ==================== TAB 2: WAREHOUSE SCANNER APP ==================== -->
    <div id="tab-scanner" class="hidden space-y-8 max-w-3xl mx-auto">
      
      <div class="double-bezel-outer">
        <div class="double-bezel-inner p-6 md:p-8 space-y-6">
          <div class="flex items-center justify-between pb-4 border-b border-white/5">
            <div>
              <span class="text-xs font-mono text-blue-400 uppercase tracking-wider">Android Field Terminal</span>
              <h2 class="text-xl font-semibold text-white mt-0.5">Warehouse QR Scanner & State Engine</h2>
            </div>
            <div class="flex items-center gap-2">
              <label for="current-operator-depot" class="text-xs text-neutral-400">Active Depot:</label>
              <select id="current-operator-depot" onchange="updateScannerUI()" class="bg-white/[0.05] border border-white/10 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="depot_1">Depósito 01 (Origin)</option>
                <option value="depot_2">Depósito 02 (Transit)</option>
                <option value="depot_3">Depósito 03 (Transit)</option>
                <option value="depot_4">Depósito 04 (Transit)</option>
                <option value="depot_5">Depósito 05 (Destination)</option>
              </select>
            </div>
          </div>

          <!-- Scanner Simulation View -->
          <div class="space-y-4">
            <div class="bg-black/60 border border-white/10 rounded-xl p-6 text-center space-y-4 relative overflow-hidden">
              <div class="absolute inset-0 bg-blue-500/5 pointer-events-none flex items-center justify-center">
                <div class="w-48 h-48 border border-dashed border-blue-500/30 rounded-xl animate-pulse"></div>
              </div>
              <div class="relative z-10">
                <div class="w-12 h-12 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center mx-auto mb-3 text-xl">📷</div>
                <h3 class="text-sm font-medium text-white">Camera Scanner Ready</h3>
                <p class="text-xs text-neutral-400 max-w-sm mx-auto mt-1">Select an active package QR code below or enter tracking code manually to simulate field scanning.</p>
              </div>

              <div class="relative z-10 flex flex-wrap items-center justify-center gap-2 pt-2" id="quick-scan-buttons">
                <!-- Dynamic QR buttons -->
              </div>
            </div>

            <!-- Manual QR Input -->
            <div class="flex gap-2">
              <input type="text" id="manual-qr-input" placeholder="Enter QR Tracking Code (e.g., PKG-101)…" class="flex-1 bg-white/[0.03] border border-white/10 rounded-lg px-4 py-2.5 text-xs text-white placeholder-neutral-500 focus:outline-none focus:ring-2 focus:ring-blue-500">
              <button onclick="handleScanAction()" class="bg-blue-600 hover:bg-blue-500 text-white px-5 py-2.5 rounded-lg text-xs font-medium transition-colors">Process Scan</button>
            </div>
          </div>

          <!-- Scanner Action Feedback / Result Box -->
          <div id="scanner-feedback" class="hidden rounded-xl p-4 bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-xs space-y-2">
            <div class="font-semibold flex items-center gap-2">
              <span>✓ Scan Successful</span>
            </div>
            <p id="scanner-feedback-text">Package successfully received at depot.</p>
          </div>

          <!-- Depot Specific Action Panel -->
          <div id="depot-action-panel" class="p-5 rounded-xl bg-white/[0.02] border border-white/5 space-y-4">
            <h4 class="text-xs font-mono uppercase tracking-wider text-neutral-400" id="depot-panel-title">Depósito 01 Actions</h4>
            <div id="depot-panel-content">
              <!-- Dynamic based on selected depot -->
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- ==================== TAB 3: DELIVERY APP ==================== -->
    <div id="tab-delivery" class="hidden space-y-8 max-w-4xl mx-auto">
      
      <div class="double-bezel-outer">
        <div class="double-bezel-inner p-6 md:p-8 space-y-6">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-white/5">
            <div>
              <span class="text-xs font-mono text-emerald-400 uppercase tracking-wider">Delivery Field Driver App</span>
              <h2 class="text-xl font-semibold text-white mt-0.5">Dispatched Orders & Final Handovers</h2>
            </div>
            <div class="flex items-center gap-2 text-xs text-neutral-400 font-mono">
              <span>Driver: Carlos Silva (ID: DRV-01)</span>
            </div>
          </div>

          <!-- Orders List -->
          <div class="space-y-4" id="delivery-orders-list">
            <!-- Dynamic -->
          </div>
        </div>
      </div>

    </div>

  </main>

  <!-- ==================== MODALS ==================== -->

  <!-- Create Package Modal -->
  <div id="create-package-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
    <div class="double-bezel-outer max-w-md w-full">
      <div class="double-bezel-inner p-6 space-y-6 bg-[#0a0a0c]">
        <div class="flex items-center justify-between pb-3 border-b border-white/5">
          <h3 class="text-base font-semibold text-white">Create New Package (Depot 01)</h3>
          <button onclick="closeModal('create-package-modal')" class="text-neutral-400 hover:text-white text-sm" aria-label="Close modal">&times;</button>
        </div>
        <div class="space-y-4 text-xs">
          <div>
            <label class="block text-neutral-400 mb-1.5 font-medium">Select Product SKU</label>
            <select id="new-pkg-sku" class="w-full bg-white/[0.05] border border-white/10 rounded-lg p-2.5 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="SKU-STARLINK-MINI">Starlink Mini (Antenna)</option>
              <option value="SKU-MOUNT-MAG">Magnetic Mount Bracket</option>
              <option value="SKU-CABLE-ETH">Ethernet Rugged Cable 15m</option>
              <option value="SKU-POWER-DC">DC Power Supply 12V</option>
            </select>
          </div>
          <div>
            <label class="block text-neutral-400 mb-1.5 font-medium">Quantity to Consolidate</label>
            <input type="number" inputmode="numeric" id="new-pkg-qty" value="5" min="1" class="w-full bg-white/[0.05] border border-white/10 rounded-lg p-2.5 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>
          <p class="text-neutral-500 text-[11px]">This will automatically deduct from Depósito 01 unit stock, generate a unique QR tracking code, and set status to EM_TRANSITO.</p>
        </div>
        <div class="flex justify-end gap-3 pt-2">
          <button onclick="closeModal('create-package-modal')" class="px-4 py-2 rounded-lg bg-white/5 text-neutral-300 hover:bg-white/10 text-xs">Cancel</button>
          <button onclick="submitCreatePackage()" class="px-5 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-xs">Consolidate & Ship</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Manual Stock Adjustment Modal (Depot 05) -->
  <div id="manual-stock-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
    <div class="double-bezel-outer max-w-md w-full">
      <div class="double-bezel-inner p-6 space-y-6 bg-[#0a0a0c]">
        <div class="flex items-center justify-between pb-3 border-b border-white/5">
          <h3 class="text-base font-semibold text-white">Manual Stock Adjustment (Depot 05)</h3>
          <button onclick="closeModal('manual-stock-modal')" class="text-neutral-400 hover:text-white text-sm" aria-label="Close modal">&times;</button>
        </div>
        <div class="space-y-4 text-xs">
          <div>
            <label class="block text-neutral-400 mb-1.5 font-medium">Product SKU</label>
            <select id="adj-sku" class="w-full bg-white/[0.05] border border-white/10 rounded-lg p-2.5 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="SKU-STARLINK-MINI">Starlink Mini (Antenna)</option>
              <option value="SKU-MOUNT-MAG">Magnetic Mount Bracket</option>
              <option value="SKU-CABLE-ETH">Ethernet Rugged Cable 15m</option>
              <option value="SKU-POWER-DC">DC Power Supply 12V</option>
            </select>
          </div>
          <div>
            <label class="block text-neutral-400 mb-1.5 font-medium">New Absolute Balance / Quantity</label>
            <input type="number" inputmode="numeric" id="adj-qty" value="25" min="0" class="w-full bg-white/[0.05] border border-white/10 rounded-lg p-2.5 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>
          <p class="text-neutral-500 text-[11px]">Used by administrators to correct physical inventory discrepancies at destination.</p>
        </div>
        <div class="flex justify-end gap-3 pt-2">
          <button onclick="closeModal('manual-stock-modal')" class="px-4 py-2 rounded-lg bg-white/5 text-neutral-300 hover:bg-white/10 text-xs">Cancel</button>
          <button onclick="submitStockAdjustment()" class="px-5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-xs">Update Balance</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Admin Override Delete Confirmation Modal -->
  <div id="admin-delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
    <div class="double-bezel-outer max-w-md w-full">
      <div class="double-bezel-inner p-6 space-y-6 bg-[#0a0a0c]">
        <div class="flex items-center justify-between pb-3 border-b border-white/5">
          <h3 class="text-base font-semibold text-red-400">Admin Override: Delete / Damage Package</h3>
          <button onclick="closeModal('admin-delete-modal')" class="text-neutral-400 hover:text-white text-sm" aria-label="Close modal">&times;</button>
        </div>
        <div class="space-y-4 text-xs">
          <p class="text-neutral-300">You are about to flag package <span id="del-pkg-code" class="font-mono font-semibold text-white">PKG-000</span> as lost/damaged (Admin Exception). This generates an immutable audit log.</p>
          <div>
            <label class="block text-neutral-400 mb-1.5 font-medium">Admin Password / PIN Required</label>
            <input type="password" id="admin-pin" placeholder="Enter admin password…" class="w-full bg-white/[0.05] border border-white/10 rounded-lg p-2.5 text-white focus:outline-none focus:ring-2 focus:ring-red-500">
          </div>
        </div>
        <div class="flex justify-end gap-3 pt-2">
          <button onclick="closeModal('admin-delete-modal')" class="px-4 py-2 rounded-lg bg-white/5 text-neutral-300 hover:bg-white/10 text-xs">Cancel</button>
          <button onclick="confirmAdminDelete()" class="px-5 py-2 rounded-lg bg-red-600 hover:bg-red-500 text-white font-medium text-xs">Confirm Exception</button>
        </div>
      </div>
    </div>
  </div>


  <!-- Custom Toast Notification Container -->
  <div id="toast-container" class="fixed bottom-4 right-4 z-[60] flex flex-col gap-2 pointer-events-none"></div>

  <!-- Custom Confirm Modal -->
  <div id="app-confirm-modal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm transition-opacity">
    <div class="double-bezel-outer max-w-sm w-full shadow-2xl">
      <div class="double-bezel-inner p-6 space-y-6 bg-[#0a0a0c]">
        <div class="space-y-2">
          <h3 class="text-base font-semibold text-white">Please Confirm</h3>
          <p id="app-confirm-text" class="text-xs text-neutral-400 leading-relaxed"></p>
        </div>
        <div class="flex justify-end gap-3 pt-2">
          <button onclick="closeAppConfirm()" class="px-4 py-2 rounded-lg bg-white/5 text-neutral-300 hover:bg-white/10 text-xs transition-colors">Cancel</button>
          <button id="app-confirm-btn" class="px-5 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-xs transition-colors shadow-lg">Confirm</button>
        </div>
      </div>
    </div>
  </div>

  <!-- JavaScript Application Logic -->

  <script>
    // --- Initial State & Mock DB ---
    const STORAGE_KEY = 'nexuslog_state_v1';

    // --- Hardened UI Utils (Toasts & Confirms) ---
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      
      const colors = {
        success: 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400',
        error: 'bg-red-500/10 border-red-500/20 text-red-400',
        info: 'bg-blue-500/10 border-blue-500/20 text-blue-400'
      };
      
      const icons = {
        success: '✓',
        error: '✕',
        info: 'ℹ'
      };

      toast.className = `flex items-center gap-3 px-4 py-3 rounded-xl border ${colors[type]} backdrop-blur-md shadow-lg transform transition-all duration-300 translate-y-4 opacity-0`;
      toast.innerHTML = `<span class="font-bold">${icons[type]}</span><span class="text-xs font-medium">${message}</span>`;
      
      container.appendChild(toast);
      
      // Animate in
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-4', 'opacity-0');
      });
      
      // Animate out after 3.5s
      setTimeout(() => {
        toast.classList.add('opacity-0', 'scale-95');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    let confirmCallback = null;
    function showConfirm(message, onConfirm, isDestructive = false) {
      document.getElementById('app-confirm-text').innerText = message;
      const btn = document.getElementById('app-confirm-btn');
      
      if (isDestructive) {
        btn.className = 'px-5 py-2 rounded-lg bg-red-600 hover:bg-red-500 text-white font-medium text-xs transition-colors shadow-lg';
      } else {
        btn.className = 'px-5 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-xs transition-colors shadow-lg';
      }

      confirmCallback = onConfirm;
      document.getElementById('app-confirm-modal').classList.remove('hidden');
    }

    function closeAppConfirm() {
      document.getElementById('app-confirm-modal').classList.add('hidden');
      confirmCallback = null;
    }

    document.getElementById('app-confirm-btn').addEventListener('click', () => {
      if (confirmCallback) confirmCallback();
      closeAppConfirm();
    });


    function getInitialState() {
      return {
        inventories: {
          depot_1: {
            'SKU-STARLINK-MINI': { name: 'Starlink Mini (Antenna)', category: 'Hardware', qty: 120 },
            'SKU-MOUNT-MAG': { name: 'Magnetic Mount Bracket', category: 'Accessories', qty: 250 },
            'SKU-CABLE-ETH': { name: 'Ethernet Rugged Cable 15m', category: 'Cables', qty: 180 },
            'SKU-POWER-DC': { name: 'DC Power Supply 12V', category: 'Power', qty: 95 }
          },
          depot_5: {
            'SKU-STARLINK-MINI': { name: 'Starlink Mini (Antenna)', category: 'Hardware', qty: 15 },
            'SKU-MOUNT-MAG': { name: 'Magnetic Mount Bracket', category: 'Accessories', qty: 30 },
            'SKU-CABLE-ETH': { name: 'Ethernet Rugged Cable 15m', category: 'Cables', qty: 20 },
            'SKU-POWER-DC': { name: 'DC Power Supply 12V', category: 'Power', qty: 10 }
          }
        },
        packages: [
          { code: 'PKG-101', status: 'EM_TRANSITO', depotId: 'depot_2', sku: 'SKU-STARLINK-MINI', qty: 10, updatedAt: new Date(Date.now() - 3600000 * 2).toISOString() },
          { code: 'PKG-102', status: 'EM_TRANSITO', depotId: 'depot_3', sku: 'SKU-MOUNT-MAG', qty: 25, updatedAt: new Date(Date.now() - 3600000 * 55).toISOString() }, // Stalled > 48h for alert
          { code: 'PKG-103', status: 'DESMONTADO', depotId: 'depot_5', sku: 'SKU-CABLE-ETH', qty: 15, updatedAt: new Date(Date.now() - 3600000 * 12).toISOString() }
        ],
        auditLogs: [
          { timestamp: new Date(Date.now() - 3600000 * 2).toISOString(), packageCode: 'PKG-101', depot: 'Depósito 01', user: 'Op. Silva (ID: 04)', action: 'CRIACAO (Consolidation)' },
          { timestamp: new Date(Date.now() - 3600000 * 55).toISOString(), packageCode: 'PKG-102', depot: 'Depósito 01', user: 'Op. Silva (ID: 04)', action: 'CRIACAO (Consolidation)' }
        ],
        deliveryOrders: [
          { id: 'ORD-801', client: 'Fazenda Santa Rita', address: 'Rodovia BR-163, Km 42 - Zona Rural', status: 'PENDENTE', items: '1x Starlink Mini, 1x Magnetic Mount' },
          { id: 'ORD-802', client: 'Cooperativa Agrícola Sul', address: 'Av. das Nações, 1420 - Centro', status: 'PENDENTE', items: '2x Ethernet Cable 15m, 1x DC Power Supply' }
        ]
      };
    }

    let db = JSON.parse(localStorage.getItem(STORAGE_KEY)) || getInitialState();

    function saveDB() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(db));
      renderAll();
    }

    function resetDemoData() {
      db = getInitialState();
      saveDB();
    }

    // --- Navigation Tabs ---
    function switchTab(tab) {
      document.getElementById('tab-admin').classList.add('hidden');
      document.getElementById('tab-scanner').classList.add('hidden');
      document.getElementById('tab-delivery').classList.add('hidden');

      document.getElementById('nav-btn-admin').className = 'px-4 py-1.5 rounded-full transition-all duration-300 text-neutral-400 hover:text-white';
      document.getElementById('nav-btn-scanner').className = 'px-4 py-1.5 rounded-full transition-all duration-300 text-neutral-400 hover:text-white';
      document.getElementById('nav-btn-delivery').className = 'px-4 py-1.5 rounded-full transition-all duration-300 text-neutral-400 hover:text-white';

      document.getElementById('mob-btn-admin').className = 'flex flex-col items-center gap-1 p-2 w-full text-neutral-500 hover:text-neutral-300 transition-colors';
      document.getElementById('mob-btn-scanner').className = 'flex flex-col items-center gap-1 p-2 w-full text-neutral-500 hover:text-neutral-300 transition-colors';
      document.getElementById('mob-btn-delivery').className = 'flex flex-col items-center gap-1 p-2 w-full text-neutral-500 hover:text-neutral-300 transition-colors';

      if (tab === 'admin') {
        document.getElementById('tab-admin').classList.remove('hidden');
        document.getElementById('nav-btn-admin').className = 'px-4 py-1.5 rounded-full transition-all duration-300 text-white bg-white/10 shadow-sm';
        document.getElementById('mob-btn-admin').className = 'flex flex-col items-center gap-1 p-2 w-full text-white transition-colors';
      } else if (tab === 'scanner') {
        document.getElementById('tab-scanner').classList.remove('hidden');
        document.getElementById('nav-btn-scanner').className = 'px-4 py-1.5 rounded-full transition-all duration-300 text-white bg-white/10 shadow-sm';
        document.getElementById('mob-btn-scanner').className = 'flex flex-col items-center gap-1 p-2 w-full text-white transition-colors';
        updateScannerUI();
      } else if (tab === 'delivery') {
        document.getElementById('tab-delivery').classList.remove('hidden');
        document.getElementById('nav-btn-delivery').className = 'px-4 py-1.5 rounded-full transition-all duration-300 text-white bg-white/10 shadow-sm';
        document.getElementById('mob-btn-delivery').className = 'flex flex-col items-center gap-1 p-2 w-full text-white transition-colors';
        renderDeliveryOrders();
      }
    }

    // --- Modal Controls ---
    function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
    function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

    // --- Onboarding Logic ---
    function checkOnboarding() {
      if (!localStorage.getItem('nexuslog_onboarding_dismissed_v1')) {
        const banner = document.getElementById('onboarding-banner');
        if (banner) banner.classList.remove('hidden');
      }
    }

    function dismissOnboarding() {
      localStorage.setItem('nexuslog_onboarding_dismissed_v1', 'true');
      document.getElementById('onboarding-banner').classList.add('hidden');
    }

    // --- Render All UI ---
    function renderAll() {
      checkOnboarding();
      renderKPIs();
      renderInventories();
      renderPackagesTable();
      renderAuditLogs();
      renderDeliveryOrders();
      if (!document.getElementById('tab-scanner').classList.contains('hidden')) {
        updateScannerUI();
      }
    }

    function renderKPIs() {
      const transitCount = db.packages.filter(p => p.status === 'EM_TRANSITO').length;
      const deliveredCount = db.packages.filter(p => p.status === 'ENTREGUE').length;
      
      // Delay alerts: packages in transit created more than 48 hours ago
      const now = Date.now();
      const alertCount = db.packages.filter(p => p.status === 'EM_TRANSITO' && (now - new Date(p.updatedAt).getTime() > 3600000 * 48)).length;

      document.getElementById('kpi-transit').innerText = transitCount;
      document.getElementById('kpi-delivered').innerText = deliveredCount;
      document.getElementById('kpi-alerts').innerText = alertCount;
      document.getElementById('kpi-audits').innerText = db.auditLogs.length;
    }

    function renderInventories() {
      // Depot 01
      const depot1Tbody = document.getElementById('inventory-depot-1');
      depot1Tbody.innerHTML = '';
      for (let sku in db.inventories.depot_1) {
        const item = db.inventories.depot_1[sku];
        depot1Tbody.innerHTML += `
          <tr class="relative">
            <td data-label="Product" class="py-3 font-medium text-white">${item.name} <div class="text-[11px] text-neutral-500 font-mono">${sku}</div></td>
            <td data-label="Category" class="py-3 text-neutral-400">${item.category}</td>
            <td data-label="Available Qty" class="py-3 text-right font-mono font-semibold text-white">${item.qty} units</td>
          </tr>
        `;
      }

      // Depot 05
      const depot5Tbody = document.getElementById('inventory-depot-5');
      depot5Tbody.innerHTML = '';
      for (let sku in db.inventories.depot_5) {
        const item = db.inventories.depot_5[sku];
        depot5Tbody.innerHTML += `
          <tr class="relative">
            <td data-label="Product" class="py-3 font-medium text-white">${item.name} <div class="text-[11px] text-neutral-500 font-mono">${sku}</div></td>
            <td data-label="Category" class="py-3 text-neutral-400">${item.category}</td>
            <td data-label="Unit Stock" class="py-3 text-right font-mono font-semibold text-emerald-400">${item.qty} units</td>
          </tr>
        `;
      }
    }

    function renderPackagesTable() {
      const search = document.getElementById('package-search').value.toLowerCase();
      const tbody = document.getElementById('packages-table-body');
      tbody.innerHTML = '';

      const filtered = db.packages.filter(p => p.code.toLowerCase().includes(search) || p.sku.toLowerCase().includes(search));

      if (db.packages.length === 0) {
        // True Empty State (First Use / Cleared DB)
        tbody.innerHTML = `<tr>
          <td colspan="6" class="py-16">
            <div class="flex flex-col items-center justify-center space-y-4">
              <div class="w-16 h-16 rounded-full bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 text-2xl shadow-inner">📦</div>
              <div class="text-center space-y-1">
                <h4 class="text-sm font-semibold text-white">No active packages</h4>
                <p class="text-xs text-neutral-400 max-w-sm">The tracking system is completely empty. Create a package from Depot 01 to begin the logistics simulation.</p>
              </div>
              <button onclick="openModal('create-package-modal')" class="mt-2 bg-blue-600 hover:bg-blue-500 text-white px-5 py-2.5 rounded-lg text-xs font-medium transition-colors shadow-lg shadow-blue-900/20">Create First Package</button>
            </div>
          </td>
        </tr>`;
        return;
      } else if (filtered.length === 0) {
        // No Results State (Search filtered out everything)
        tbody.innerHTML = `<tr>
          <td colspan="6" class="py-12">
            <div class="flex flex-col items-center justify-center space-y-3">
              <div class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-neutral-500 text-lg">🔍</div>
              <p class="text-neutral-400 text-xs font-medium">No packages found matching "${search}"</p>
              <button onclick="document.getElementById('package-search').value=''; renderPackagesTable()" class="text-xs text-blue-400 hover:text-blue-300 transition-colors mt-2">Clear Search Filters</button>
            </div>
          </td>
        </tr>`;
        return;
      }

      filtered.forEach(p => {
        let badgeColor = 'bg-blue-500/10 text-blue-400 border-blue-500/20';
        if (p.status === 'DESMONTADO') badgeColor = 'bg-purple-500/10 text-purple-400 border-purple-500/20';
        if (p.status === 'EXTRAVIADO') badgeColor = 'bg-red-500/10 text-red-400 border-red-500/20';
        if (p.status === 'ENTREGUE') badgeColor = 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';

        tbody.innerHTML += `
          <tr class="hover:bg-white/[0.02] transition-colors relative">
            <td data-label="QR Code" class="py-3 font-mono font-semibold text-white">${p.code}</td>
            <td data-label="Status" class="py-3"><span class="text-[11px] font-mono px-2.5 py-1 rounded-full border ${badgeColor}">${p.status}</span></td>
            <td data-label="Depot" class="py-3 text-neutral-300 font-mono text-xs">${p.depotId.toUpperCase()}</td>
            <td data-label="Items Summary" class="py-3 text-neutral-300 hidden md:table-cell">${p.qty}x <span class="text-xs text-neutral-400">${p.sku}</span></td>
            <td data-label="Last Update" class="py-3 text-neutral-500 text-xs font-mono hidden md:table-cell">${new Date(p.updatedAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</td>
            <td data-label="Actions" class="py-3 text-right">
              <button onclick="promptAdminDelete('${p.code}')" class="text-xs text-red-400 hover:text-red-300 bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 px-3 py-1 rounded-md transition-colors w-full sm:w-auto">Excluir (Admin)</button>
            </td>
          </tr>
        `;
      });
    }

    function renderAuditLogs() {
      const tbody = document.getElementById('audit-logs-body');
      tbody.innerHTML = '';
      
      const sortedLogs = [...db.auditLogs].reverse();
      if (sortedLogs.length === 0) {
        tbody.innerHTML = `<tr>
          <td colspan="5" class="py-12">
            <div class="flex flex-col items-center justify-center space-y-3">
              <div class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-neutral-500 text-lg">📋</div>
              <p class="text-neutral-400 text-xs font-medium">No audit logs recorded yet</p>
              <p class="text-[11px] text-neutral-500">System events and transactions will appear here.</p>
            </div>
          </td>
        </tr>`;
        return;
      }

      sortedLogs.forEach(log => {
        tbody.innerHTML += `
          <tr class="relative">
            <td data-label="Timestamp" class="py-2.5 text-neutral-500 hidden sm:table-cell">${new Date(log.timestamp).toLocaleString()}</td>
            <td data-label="Package ID" class="py-2.5 font-semibold text-white">${log.packageCode}</td>
            <td data-label="Depot" class="py-2.5 text-neutral-300">${log.depot}</td>
            <td data-label="User" class="py-2.5 text-neutral-400 hidden md:table-cell">${log.user}</td>
            <td data-label="Action" class="py-2.5 text-blue-400 font-medium">${log.action}</td>
          </tr>
        `;
      });
    }

    // --- Depot 01: Create Package ---
    function submitCreatePackage() {
      const sku = document.getElementById('new-pkg-sku').value;
      const qty = parseInt(document.getElementById('new-pkg-qty').value);

      if (qty <= 0) { showToast('Quantity must be greater than zero.', 'error'); return; }
      if (db.inventories.depot_1[sku].qty < qty) {
        showToast('Insufficient stock in Depósito 01 for this consolidation!', 'error');
        return;
      }

      // Deduct stock
      db.inventories.depot_1[sku].qty -= qty;

      // Generate package
      const newCode = 'PKG-' + Math.floor(100 + Math.random() * 900);
      db.packages.push({
        code: newCode,
        status: 'EM_TRANSITO',
        depotId: 'depot_1',
        sku: sku,
        qty: qty,
        updatedAt: new Date().toISOString()
      });

      // Audit log
      db.auditLogs.push({
        timestamp: new Date().toISOString(),
        packageCode: newCode,
        depot: 'Depósito 01',
        user: 'Operador Admin',
        action: `CRIACAO (Consolidated ${qty}x ${sku})`
      });

      closeModal('create-package-modal');
      saveDB();
      showToast(`Package ${newCode} successfully created and dispatched!`, 'success');
    }

    // --- Depot 05: Manual Stock Adjustment ---
    function submitStockAdjustment() {
      const sku = document.getElementById('adj-sku').value;
      const newQty = parseInt(document.getElementById('adj-qty').value);

      db.inventories.depot_5[sku].qty = newQty;
      db.auditLogs.push({
        timestamp: new Date().toISOString(),
        packageCode: 'SYSTEM',
        depot: 'Depósito 05',
        user: 'Administrator',
        action: `AJUSTE_MANUAL (Set ${sku} to ${newQty})`
      });

      closeModal('manual-stock-modal');
      saveDB();
      showToast('Depósito 05 inventory balance successfully updated.', 'success');
    }

    // --- Admin Override Delete ---
    let packageToDelete = null;
    function promptAdminDelete(code) {
      packageToDelete = code;
      document.getElementById('del-pkg-code').innerText = code;
      document.getElementById('admin-pin').value = '';
      openModal('admin-delete-modal');
    }

    function confirmAdminDelete() {
      const pin = document.getElementById('admin-pin').value;
      const btn = document.querySelector('#admin-delete-modal button.bg-red-600');
      const originalText = btn.innerText;
      
      // Prevent double submission & simulate network check
      btn.disabled = true;
      btn.innerText = 'Verifying...';
      btn.classList.add('opacity-70', 'cursor-not-allowed');

      setTimeout(() => {
        btn.disabled = false;
        btn.innerText = originalText;
        btn.classList.remove('opacity-70', 'cursor-not-allowed');

        if (pin !== 'admin123' && pin !== '1234') { // Simple demo security PIN
          showToast('Invalid Admin PIN! Verification failed.', 'error');
          return;
        }

        const pkgIndex = db.packages.findIndex(p => p.code === packageToDelete);
        if (pkgIndex !== -1) {
          const pkg = db.packages[pkgIndex];
          db.packages.splice(pkgIndex, 1);
          db.auditLogs.push({
            timestamp: new Date().toISOString(),
            packageCode: packageToDelete,
            depot: pkg.depotId,
            user: 'Admin Override',
            action: 'EXCLUSAO_ADMIN (Exception handled)'
          });
        }

        closeModal('admin-delete-modal');
        saveDB();
        showToast(`Package ${packageToDelete} deleted via Admin Exception.`, 'success');
      }, 500);
    }

    // --- Warehouse Scanner App Logic ---
    function updateScannerUI() {
      const depot = document.getElementById('current-operator-depot').value;
      const titleEl = document.getElementById('depot-panel-title');
      const contentEl = document.getElementById('depot-panel-content');
      const quickBtns = document.getElementById('quick-scan-buttons');

      quickBtns.innerHTML = '';
      if (db.packages.length === 0) {
        quickBtns.innerHTML = `
          <div class="w-full mt-2 p-3 rounded-lg bg-blue-500/10 border border-blue-500/20 text-[11px] text-blue-300">
            <strong>No active packages to scan.</strong> Create a package from the Admin Dashboard first.
          </div>
        `;
      } else {
        db.packages.forEach(p => {
          quickBtns.innerHTML += `
            <button onclick="document.getElementById('manual-qr-input').value='${p.code}'; handleScanAction();" class="text-xs font-mono bg-white/5 hover:bg-white/10 border border-white/10 px-3 py-1.5 rounded-lg text-white transition-colors">
              Scan ${p.code} (${p.status})
            </button>
          `;
        });
      }

      if (depot === 'depot_1') {
        titleEl.innerText = 'Depósito 01: Consolidation & Dispatch';
        contentEl.innerHTML = `
          <p class="text-xs text-neutral-300 mb-3">At Depósito 01, operators create shipping batches. Click below to open the creation modal.</p>
          <button onclick="openModal('create-package-modal')" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg text-xs font-medium">Create New Package (Depot 01)</button>
        `;
      } else if (depot === 'depot_2' || depot === 'depot_3' || depot === 'depot_4') {
        titleEl.innerText = `${depot.replace('_', ' ').toUpperCase()} (Transit Checkpoint)`;
        contentEl.innerHTML = `
          <p class="text-xs text-neutral-300 mb-2">Scan any incoming package QR code to register receipt at this transit hub and update tracking location.</p>
        `;
      } else if (depot === 'depot_5') {
        titleEl.innerText = 'Depósito 05 (Disassembly / Final Destination)';
        contentEl.innerHTML = `
          <p class="text-xs text-neutral-300 mb-2">Scanning a package here will prompt disassembly. Once confirmed, items are automatically added to Depósito 05 unit stock.</p>
        `;
      }
    }

    function handleScanAction() {
      const code = document.getElementById('manual-qr-input').value.trim().toUpperCase();
      const depot = document.getElementById('current-operator-depot').value;
      const feedback = document.getElementById('scanner-feedback');
      const feedbackText = document.getElementById('scanner-feedback-text');

      if (!code) { showToast('Please enter or select a valid package QR code.', 'error'); return; }

      const pkg = db.packages.find(p => p.code === code);
      if (!pkg) {
        showToast('Package not found in system database!', 'error');
        return;
      }

      feedback.classList.remove('hidden');

      if (depot === 'depot_5') {
        if (pkg.status === 'DESMONTADO') {
          feedbackText.innerText = `Package ${code} is already disassembled at Depósito 05.`;
          return;
        }
        
        // Disassembly action
        showConfirm(`Desmontar Pacote ${code}? This will add ${pkg.qty}x ${pkg.sku} to Depósito 05 unit stock.`, () => {
          pkg.status = 'DESMONTADO';
          pkg.depotId = 'depot_5';
          pkg.updatedAt = new Date().toISOString();

          // Add to depot 5 stock
          if (db.inventories.depot_5[pkg.sku]) {
            db.inventories.depot_5[pkg.sku].qty += pkg.qty;
          }

          db.auditLogs.push({
            timestamp: new Date().toISOString(),
            packageCode: code,
            depot: 'Depósito 05',
            user: 'Operador Depósito 05',
            action: `DESMONTAGEM (+${pkg.qty} added to Depot 05)`
          });

          feedbackText.innerText = `Success: Package ${code} disassembled! ${pkg.qty} units added to Depósito 05 inventory.`;
          saveDB();
          showToast(`Package ${code} disassembled successfully!`, 'success');
        });
      } else {
        // Transit or Origin scan
        pkg.depotId = depot;
        pkg.updatedAt = new Date().toISOString();

        db.auditLogs.push({
          timestamp: new Date().toISOString(),
          packageCode: code,
          depot: depot.replace('_', ' ').toUpperCase(),
          user: 'Operador Campo',
          action: `RECEBIMENTO at ${depot.toUpperCase()}`
        });

        feedbackText.innerText = `Package ${code} received and logged at ${depot.replace('_', ' ').toUpperCase()}!`;
        saveDB();
      }
    }

    // --- Delivery App Logic ---
    function renderDeliveryOrders() {
      const container = document.getElementById('delivery-orders-list');
      container.innerHTML = '';

      if (db.deliveryOrders.length === 0) {
        container.innerHTML = `
          <div class="py-16 flex flex-col items-center justify-center space-y-4 rounded-xl border border-dashed border-white/10 bg-white/[0.01]">
            <div class="w-16 h-16 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-neutral-500 text-2xl shadow-inner">🚚</div>
            <div class="text-center space-y-1">
              <h4 class="text-sm font-semibold text-white">No delivery orders</h4>
              <p class="text-[11px] text-neutral-400 max-w-xs">There are currently no active deliveries dispatched to your vehicle. New orders will appear here automatically.</p>
            </div>
          </div>
        `;
        return;
      }

      db.deliveryOrders.forEach(ord => {
        const isDelivered = ord.status === 'ENTREGUE';
        container.innerHTML += `
          <div class="p-5 rounded-xl bg-white/[0.02] border ${isDelivered ? 'border-emerald-500/20 bg-emerald-500/[0.02]' : 'border-white/10'} flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono font-bold text-white">${ord.id}</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded-full border ${isDelivered ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' : 'bg-amber-500/10 text-amber-400 border-amber-500/20'}">${ord.status}</span>
              </div>
              <h4 class="text-sm font-semibold text-white">${ord.client}</h4>
              <p class="text-xs text-neutral-400">📍 ${ord.address}</p>
              <p class="text-xs text-blue-400 font-mono">Items: ${ord.items}</p>
            </div>
            <div>
              ${isDelivered ? `
                <span class="text-xs text-emerald-400 font-medium bg-emerald-500/10 border border-emerald-500/20 px-4 py-2 rounded-lg inline-block">✓ Delivered Successfully</span>
              ` : `
                <button onclick="confirmDelivery('${ord.id}')" class="bg-emerald-600 hover:bg-emerald-500 text-white px-5 py-2.5 rounded-lg text-xs font-semibold transition-colors shadow-lg">Confirmar Entrega</button>
              `}
            </div>
          </div>
        `;
      });
    }

    function confirmDelivery(ordId) {
      const ord = db.deliveryOrders.find(o => o.id === ordId);
      if (!ord) return;

      showConfirm(`Confirmar Entrega for order ${ordId} to ${ord.client}? This will finalize checkout and deduct items permanently.`, () => {
        ord.status = 'ENTREGUE';
        
        // Also add a delivered package entry for KPI
        db.packages.push({
          code: 'DLV-' + Math.floor(1000 + Math.random() * 9000),
          status: 'ENTREGUE',
          depotId: 'depot_5',
          sku: 'SKU-STARLINK-MINI',
          qty: 1,
          updatedAt: new Date().toISOString()
        });

        db.auditLogs.push({
          timestamp: new Date().toISOString(),
          packageCode: ordId,
          depot: 'Ponta Final (Delivery)',
          user: 'Entregador Carlos Silva',
          action: 'CONFIRMACAO_ENTREGA'
        });

        saveDB();
        showToast(`Order ${ordId} successfully delivered and logged!`, 'success');
      }
    }

    // Initialize on load
    renderAll();
  </script>

</body>
</html>
